# FRAMEGEN — Environment Config
# Copy this to .env and fill in your keys
# Run `npm run setup` for an interactive wizard

# ── Required ───────────────────────────────────────────────────
# Claude API — blueprint generation
# Get at: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Video Generation (pick one) ────────────────────────────────

# Option A (recommended): Replicate — open-source models
# Free credits on sign-up. ~$0.04–0.08 per 5s clip.
# Get at: https://replicate.com/account/api-tokens
#
# Models used:
#   wavespeedai/wan-2.1-t2v-480p  — cheapest, ~40s per clip
#   wavespeedai/wan-2.1-t2v-720p  — HD, ~150s per clip
#   wan-video/wan-2.2-t2v-fast    — fast draft quality
#   lightricks/ltx-video          — near real-time, $0.019/run
REPLICATE_API_KEY=r8_...

# Option B (fallback): FAL.ai
# FAL_API_KEY=...

# ── Server ─────────────────────────────────────────────────────
PORT=3002
CLIENT_URL=http://localhost:5174
NODE_ENV=development
